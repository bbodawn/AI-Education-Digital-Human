# Python 字节码与缓存
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
.venv/
venv/

# 环境变量（内含真实服务地址，不提交）
.env

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/

# 启动器运行时产物：状态文件记录本机 PID，日志记录服务输出，都只对本机有意义
scripts/.runtime.json
scripts/logs/

# 编辑器
.idea/
.vscode/

# 本地/外部 AI 模型权重：体积大（约 628MB）且非本项目产出，不入库。
# 需要时按 scripts/README.md 的说明另行下载，再上传到 AutoDL。
models/
