# 复制为 .env 后按需修改。.env 不会提交到 Git。

# 数字人服务（LiveTalking）地址。
# 本地开发：指向本机运行中的 LiveTalking。
# 上云后：改为云端地址即可，业务代码无需任何改动。
AVATAR_BASE_URL=http://127.0.0.1:8010

# 本地大模型（Ollama）。回答在本地生成，云端只负责念出来。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# V0.3 本地语音识别。模型缓存固定位于已被 Git 忽略的 models/。
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
